{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snippet",
  "version": "0.6.1",
  "identifier": "com.snippet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Snippet",
        "width": 560,
        "height": 112,
        "minWidth": 420,
        "minHeight": 112,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MDJFRjg4QzQ2MjMzNzMKUldSek0yTEVpTzhDV0o5bGM0Z05aY2tKZExiUWRYUDlPaVk4OGRsTlFzN05uWnpybTNEbnBKZzkK",
      "endpoints": ["https://github.com/zavayu/snippet/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
